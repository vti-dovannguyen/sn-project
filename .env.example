# Sao chép thành .env rồi điền. KHÔNG commit file .env.
BACKLOG_SPACE=vti-corp
BACKLOG_API_KEY=
BACKLOG_PROJECT_KEY=SOURCENEXT_ECSITE
# Dùng backlog.jp nếu space ở Nhật
BACKLOG_DOMAIN=backlog.com

# Lịch lấy dữ liệu (giờ theo TZ_NAME), cách nhau bằng dấu phẩy
SYNC_TIMES=08:00,13:00,18:00
TZ_NAME=Asia/Ho_Chi_Minh

PORT=8080
DATA_DIR=./data

# Nên bật vì dashboard có tiêu đề issue của dự án. Để trống nếu đã có SSO hoặc VPN.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
