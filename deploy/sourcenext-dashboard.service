# Chạy không dùng Docker: sao chép vào /etc/systemd/system/, sửa đường dẫn rồi
#   sudo systemctl daemon-reload && sudo systemctl enable --now sourcenext-dashboard
[Unit]
Description=Sourcenext release dashboard
After=network-online.target

[Service]
WorkingDirectory=/opt/sourcenext-dashboard
EnvironmentFile=/opt/sourcenext-dashboard/.env
ExecStart=/usr/bin/node server.mjs
Restart=always
User=www-data

[Install]
WantedBy=multi-user.target
